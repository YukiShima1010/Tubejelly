# < CAUTION >
# このファイルには重要なトークンが含まれます。
# 絶対にGitHub等の公開の場にアップロードしないでください。


#################################################################
# 1. Discord連携の設定
#################################################################
# DiscordのBotとしてTubeJellyを動かすための設定です。
# 【トークン取得方法】
# Discord Developer Portal > Application > Bot > Reset Token

# DiscordBotを使用するかどうか（使わない場合はfalse、使用する場合はtrue）
DISCORD_ENABLED=true

# Discord Bot トークン（使用する場合）
DISCORD_TOKEN=replace_with_discord_bot_token


#################################################################
# 2. LINE連携の設定
#################################################################
# LINEの公式アカウントとしてTubeJellyを動かすための設定です。
# Discordだけ使う場合は LINE_ENABLED=false のままでOKです。
# 【トークン取得方法】
# LINE Developers Console > 作成したプロバイダー > チャンネル設定

# LINE公式アカウントを使用するかどうか（使わない場合はfalse、使用する場合はtrue）
LINE_ENABLED=false

# Messaging API > チャネルアクセストークン (ロングターム)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Basic settings > チャネルシークレット
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Webhook受信用ポート。Cloudflareからtubejelly:3330へ転送します。
LINE_WEBHOOK_PORT=3330


#################################################################
# 3. Cloudflare Tunnel の設定
#################################################################
# LINE Botを使う場合、外部からローカルへ安全に通信するための設定です。
# 【トークン取得方法】
# Cloudflare Dashboard > Zero Trust > Networks > Tunnels
# Public HostnameのServiceを http://tubejelly:3330 に設定します。

CLOUDFLARED_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token


#################################################################
# 4. システム・Jellyfin保存先の設定
#################################################################
# ログレベル: trace / debug / info / warn / error / fatal
LOG_LEVEL=info

# ホスト側の保存先。音楽とMusicVideoは別ディレクトリを指定します。
# ご自身の環境(PCやNAS)の実際のパスに書き換えてください。
MUSIC_HOST_PATH=/path/to/jellyfin/music
VIDEO_HOST_PATH=/path/to/jellyfin/video


#################################################################
# 5. ユーザー別設定
#################################################################
# 誰がリクエストしたかを判別し、ダウンロード先フォルダを分ける設定です。
# JSON配列を必ず【1行】で指定してください。
# NAME: 判別用のお好きな名前
# DISCORD_USER_ID: 開発者モードで取得できる18桁の数字
# LINE_USER_ID: LINE Developersで取得できる U から始まる文字列
# MUSIC_DL_DIR / VIDEO_DL_DIR: コンテナ内のパス(上記ボリューム宛先)

USERS_CONFIG_JSON='[{"NAME":"example","DISCORD_USER_ID":"replace_with_discord_user_id","LINE_USER_ID":"replace_with_line_user_id","MUSIC_DL_DIR":"/music","VIDEO_DL_DIR":"/video"}]'


