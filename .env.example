# Discord Bot Token
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_TOKEN=your_discord_bot_token_here

# LINE Messaging API 設定
# Messaging APIチャネルの長期チャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# Messaging APIチャネルシークレット
LINE_CHANNEL_SECRET=your_line_channel_secret_here
# LINE Webhook / Chrome拡張機能API 共用のHTTPポート
LINE_WEBHOOK_PORT=3330

# Chrome拡張機能 設定
# true にすると /ext/v1 で拡張機能用APIを受け付ける（Cloudflare Tunnelの同じホスト名で公開される）
EXTENSION_API_ENABLED=true
# 拡張機能のアクセストークン（ハッシュ）の保存先。省略時は <作業ディレクトリ>/data/extension-tokens.json
# （Docker では作業ディレクトリが /app のため、名前付きボリューム /app/data に保存される）
# EXTENSION_TOKEN_STORE_PATH=./data/extension-tokens.json

# Cloudflare Tunnel 設定（Docker 内 cloudflared 用）
# Public Hostname の転送先は http://tubejelly:3330 を指定してください
CLOUDFLARED_TUNNEL_TOKEN=your_cloudflared_tunnel_token_here

# Jellyfinの音楽ライブラリのパス
# 【重要】Docker使用時は必ず /music に設定してください
# (ホストマシンのパスは docker-compose.yml のボリュームマウントで指定します)
JELLYFIN_MUSIC_PATH=/music