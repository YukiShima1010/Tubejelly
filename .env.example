# =============================================================================
# TubeJelly 環境変数
# このファイルを .env にコピーして編集してください: cp .env.example .env
# 値の取得方法は doc/setup/GETTING_STARTED.md を参照
# =============================================================================

# --- Discord（必須） ---------------------------------------------------------
# Discord Developer Portal (https://discord.com/developers/applications) の Bot → Reset Token で取得
# Bot 設定の「MESSAGE CONTENT INTENT」を必ずオンにしてください
DISCORD_TOKEN=

# --- LINE（任意） ------------------------------------------------------------
# 使わない場合は2つとも空のままにしてください（両方に値があるとLINE連携が有効になります）
# Messaging APIチャネルの長期チャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=
# Messaging APIチャネルシークレット
LINE_CHANNEL_SECRET=

# --- HTTPサーバー ------------------------------------------------------------
# LINE Webhook / Chrome拡張機能API 共用のポート（通常は変更不要）
LINE_WEBHOOK_PORT=3330

# --- Chrome拡張機能（任意） --------------------------------------------------
# true にすると /ext/v1 で拡張機能用APIを受け付ける（Cloudflare Tunnelの同じホスト名で公開される）
EXTENSION_API_ENABLED=false
# 拡張機能のアクセストークン（ハッシュ）の保存先。省略時は <作業ディレクトリ>/data/extension-tokens.json
# （Docker では作業ディレクトリが /app のため、名前付きボリューム /app/data に保存される）
# EXTENSION_TOKEN_STORE_PATH=./data/extension-tokens.json

# --- Cloudflare Tunnel -------------------------------------------------------
# docker-compose.yml の cloudflared コンテナが使用します（LINE・拡張機能を外部公開するため）
# Cloudflare Zero Trust → Networks → Tunnels で作成したトンネルのトークン
# Public Hostname の Service には http://tubejelly:3330 を指定してください
CLOUDFLARED_TUNNEL_TOKEN=
