{
  "name": "tubejelly",
  "version": "3.0.0",
  "private": false,
  "description": "YouTubeに投稿されているMusic/MusicVideoをJellyfinに自動で追加するDiscordBot/LINE公式アカウント",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "discord",
    "bot",
    "youtube",
    "mp3",
    "jellyfin",
    "typescript"
  ],
  "author": {
    "name": "YukiShima",
    "url": "https://github.com/YukiShima1010"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YukiShima1010/tubejelly.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "chalk": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "execa": "^10.0.1",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}