{
  "name": "tubejelly",
  "version": "1.1.0",
  "description": "YouTube動画をMP3としてダウンロードし、Jellyfinの音楽ライブラリに保存するDiscordBot",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc && cp -r src/config dist/config",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "discord",
    "bot",
    "youtube",
    "mp3",
    "jellyfin",
    "typescript"
  ],
  "author": "YukiShima1010",
  "dependencies": {
    "chalk": "^5.6.2",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "execa": "^9.6.1",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
